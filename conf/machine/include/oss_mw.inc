MW_EXTENSION = "-middleware"
MW_OSS = "${@get_oss_arch(d)}${MW_EXTENSION}"
PACKAGE_EXTRA_ARCHS:append = " ${MW_OSS} "
OPKG_ARCH_PRIORITY:${MW_OSS} = "205"
MW_OSS_IPK_PATH ?= "middleware-dbg/${RELEASE_NUM}"
MW_OSS_IPK_SERVER_PATH = "${RDK_ARTIFACTS_BASE_URL}/${MW_OSS_IPK_PATH}/${RDK_MW_ARCH}/${MW_OSS}/ipks/${BUILD_VARIANT}"
IPK_FEED_URIS += " ${MW_OSS}##${MW_OSS_IPK_SERVER_PATH} "


MW_OSS_PRIORITY_OVERRIDE = "${MW_OSS}-override"
PACKAGE_EXTRA_ARCHS:append = " ${MW_OSS_PRIORITY_OVERRIDE}"
OPKG_ARCH_PRIORITY:${MW_OSS_PRIORITY_OVERRIDE} = "350"

MW_OSS_PRIORITY_OVERRIDE_IPK_PATH ?= "middleware-rel/${RELEASE_NUM}"
MW_OSS_PRIORITY_OVERRIDE_IPK_SERVER_PATH = "${RDK_ARTIFACTS_BASE_URL}/${MW_OSS_PRIORITY_OVERRIDE_IPK_PATH}/${RDK_MW_ARCH}/${MW_OSS_PRIORITY_OVERRIDE}/ipks/${BUILD_VARIANT}"
IPK_FEED_URIS += " ${MW_OSS_PRIORITY_OVERRIDE}##${MW_OSS_PRIORITY_OVERRIDE_IPK_SERVER_PATH} "

